# Copy to .env (next to manage.py) and adjust. Never commit the real .env file.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string

# Development defaults. In production set DEBUG=False and list your real host names.
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
# Production over HTTPS only (ignored when DEBUG=True):
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# Database: SQLite (db.sqlite3) when unset. Set it to use Postgres (psycopg 3):
# DATABASE_URL=postgres://beacon:beacon@localhost:5432/beacon
# DB_CONN_MAX_AGE=60

# Server time zone for anything not tied to a user; people see times in their own profile time zone.
# TIME_ZONE=UTC

# Used for absolute links in paging emails.
SITE_URL=http://127.0.0.1:8000

# Emails print to the console by default. For real email, set an SMTP backend:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Beacon <noreply@example.com>

# Events API rate limit, per API key: EVENTS_RATE_LIMIT requests per fixed window of
# EVENTS_RATE_LIMIT_WINDOW seconds. Over the limit the API answers 429 with a Retry-After header.
EVENTS_RATE_LIMIT=120
EVENTS_RATE_LIMIT_WINDOW=60
